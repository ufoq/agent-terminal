{
  "name": "@ufoq/opencode-agent-terminal",
  "version": "0.1.1",
  "description": "OpenCode plugin that bundles the agent-terminal CLI, skill, and a pinned Zellij binary",
  "type": "module",
  "license": "MIT",
  "author": "ufoq",
  "homepage": "https://github.com/ufoq/agent-terminal#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ufoq/agent-terminal.git",
    "directory": "opencode/npm/opencode-agent-terminal"
  },
  "keywords": [
    "opencode",
    "plugin",
    "skill",
    "terminal",
    "zellij",
    "agent"
  ],
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "oc-plugin": [
    "server"
  ],
  "files": [
    "dist",
    "skills",
    "bin",
    "LICENSE",
    "README.md",
    "THIRD_PARTY.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && bun run build",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
