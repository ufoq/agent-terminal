{
  "name": "agent-terminal-opencode",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node npm/scripts/build.mjs",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run build && bun test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "e2e:opencode": "cd .. && bash scripts/e2e-opencode-local.sh",
    "e2e:opencode:skip-prompt": "cd .. && AGENT_TERMINAL_ENABLE_PROMPT_E2E=0 bash scripts/e2e-opencode-local.sh",
    "e2e:opencode:real": "cd .. && bash scripts/e2e-opencode-real.sh",
    "release:check": "bun run check && bun run e2e:opencode"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
