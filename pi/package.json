{
  "name": "agent-terminal-pi",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node npm/scripts/build.mjs",
    "version:check": "node ../scripts/release-version.mjs check",
    "check": "bun run version:check && bun run format:check && bun run lint && bun run typecheck && bun run build && bun test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "release:check": "bun run check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
