{
  "name": "@ufoq/pi-agent-terminal",
  "version": "0.1.4",
  "description": "pi coding agent extension that bundles the Linux x86_64 agent-terminal CLI and skill",
  "type": "module",
  "license": "MIT",
  "author": "ufoq",
  "homepage": "https://github.com/ufoq/agent-terminal#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ufoq/agent-terminal.git",
    "directory": "pi/npm/packages/pi-agent-terminal"
  },
  "keywords": [
    "pi",
    "coding-agent",
    "extension",
    "skill",
    "terminal",
    "zellij",
    "agent"
  ],
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "skills",
    "bin/linux-x64",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "check": "tsc --noEmit && bun run build",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
