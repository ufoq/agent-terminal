{
  "name": "agent-terminal-omp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node npm/scripts/build.mjs",
    "version:check": "node ../scripts/release-version.mjs check",
    "check": "bun run version:check && bun run format:check && bun run lint && bun run typecheck && bun run build && bun test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "e2e:omp": "cd .. && AGENT_TERMINAL_AGENT=omp AGENT_TERMINAL_ENABLE_PROMPT_E2E=1 bash scripts/e2e-pi-local.sh",
    "e2e:omp:skip-prompt": "cd .. && AGENT_TERMINAL_AGENT=omp AGENT_TERMINAL_ENABLE_PROMPT_E2E=0 bash scripts/e2e-pi-local.sh",
    "e2e:omp:real": "cd .. && AGENT_TERMINAL_AGENT=omp bash scripts/e2e-pi-real.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
